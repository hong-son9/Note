{
  // Worker chỉ phục vụ file tĩnh — không có script, chỉ có thư mục assets.
  // Cloudflare Workers Builds đọc file này khi deploy từ Git.
  "name": "misty-grass-d263",
  "compatibility_date": "2026-09-11",
  // Chạy build.js trước khi deploy. Để ngay trong repo để không phụ thuộc
  // vào việc ô "Build command" trên dashboard có được điền hay không.
  // Dùng Node thay vì ./build.sh: trên Windows wrangler gọi lệnh qua cmd,
  // cmd không chạy được ./build.sh.
  "build": {
    "command": "node build.js"
  },
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
