#!/usr/bin/env bash
# Push lên main -> deploy luôn lên Cloudflare bằng wrangler từ máy này.
# (Cloudflare không tự build được vì kết nối GitHub của tài khoản đang bị chặn.)
# Bật một lần cho repo:  git config core.hooksPath .githooks
# Bỏ qua một lần:        SKIP_DEPLOY=1 git push
set -e
[ -n "$SKIP_DEPLOY" ] && exit 0

deploy=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] && [ "$local_sha" != "0000000000000000000000000000000000000000" ] && deploy=1
done
[ "$deploy" = 1 ] || exit 0

cd "$(git rev-parse --show-toplevel)"
if [ -n "$(git status --porcelain --untracked-files=no -- index.html styles.css app.js _headers)" ]; then
  echo "✗ Có thay đổi chưa commit trong index.html / styles.css / app.js / _headers."
  echo "  Commit hoặc stash trước khi push để bản deploy khớp với code trên GitHub."
  exit 1
fi

echo "→ Deploy lên Cloudflare..."
npx --yes wrangler deploy < /dev/null || {
  echo "✗ Deploy thất bại -> huỷ push. (Bỏ qua deploy: SKIP_DEPLOY=1 git push)"
  exit 1
}
